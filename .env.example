# ============================================================================
#  Crystal Clear Window Cleaning — environment variables
#  Copy this file to `.env.local` and fill in real values. NEVER commit
#  `.env.local`. Only variables prefixed with NEXT_PUBLIC_ reach the browser.
# ============================================================================

# Which email provider sends quote requests: "resend" | "formspree" | "emailjs"
EMAIL_PROVIDER=resend

# --- Resend (recommended) — https://resend.com -------------------------------
# Create an API key and verify your sending domain (SPF/DKIM) before launch.
RESEND_API_KEY=
# The "from" must be on a domain you've verified in Resend.
QUOTE_FROM_EMAIL=quotes@yourdomain.com
# Where quote requests are delivered (the business inbox).
QUOTE_TO_EMAIL=owner@yourdomain.com

# --- Formspree (alternative) — https://formspree.io --------------------------
# Set EMAIL_PROVIDER=formspree and paste your form id (the bit after /f/).
# FORMSPREE_FORM_ID=

# --- EmailJS (alternative, browser-based) — https://www.emailjs.com ----------
# EmailJS runs client-side; see README for the client integration pattern.
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Optional: Cloudflare Turnstile (extra spam protection) ------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
